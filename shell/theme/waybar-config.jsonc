{"layer":"top","position":"top","height":34,"margin-top":4,"margin-left":8,"margin-right":8,
"modules-left":["hyprland/workspaces"],
"modules-center":["clock"],
"modules-right":["cpu","memory","network","tray"],
"hyprland/workspaces":{"format":"{id}"},
"clock":{"format":"{:%H:%M}","format-alt":"{:%A, %B %d}"},
"cpu":{"format":"CPU {usage}%","interval":5},
"memory":{"format":"RAM {percentage}%","interval":5},
"network":{"format-ethernet":"{ipaddr}","format-disconnected":"offline"},
"tray":{"spacing":8}}
